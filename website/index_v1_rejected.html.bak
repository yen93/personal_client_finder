<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Julienne · Office automation that gives your team hours back</title>
<meta name="description" content="I build automations that take repetitive office work off your team's plate: lead follow-up, CRM updates, inbox triage and reporting. Book a free 15-minute time-waster audit.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<!-- ======================================================================
     SITE SETTINGS: the only block you need to edit before going live.
     Leave a value as "" if you don't have it yet; the page still works and
     a yellow reminder bar lists what is missing (it hides itself once
     everything is filled in).
     ====================================================================== -->
<script>
  window.SITE = {
    brand:      "Julienne",   // wordmark shown in the header and footer
    tagline:    "Office automation",
    bookingUrl: "",           // your calendar link (Calendly, Google Calendar booking page, ...)
    email:      "",           // your OWN business address on your own domain
    location:   "",           // e.g. "Brisbane, Australia" (shown in the footer)
    abn:        ""            // optional
  };
</script>

<style>
  :root {
    --paper: #f6f1e7;
    --card: #fffdf8;
    --ink: #17201b;
    --muted: #5b655f;
    --line: #e3dbcb;
    --green: #1f4d3a;
    --green-soft: #e4ece4;
    --accent: #cf4f1c;
    --accent-dark: #ad3f13;
    --radius: 14px;
    --wrap: 1080px;
    --serif: "Fraunces", Georgia, "Times New Roman", serif;
    --sans: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.6;
  }
  img, svg { max-width: 100%; }
  a { color: inherit; }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 24px; }
  section { padding: 84px 0; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 600; line-height: 1.12; margin: 0; text-wrap: balance; letter-spacing: -0.01em; }
  h1 { font-size: clamp(2.3rem, 5.4vw, 3.9rem); }
  h2 { font-size: clamp(1.8rem, 3.6vw, 2.6rem); }
  h3 { font-size: 1.25rem; line-height: 1.25; }
  p { margin: 0; }
  .eyebrow {
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--accent-dark); margin-bottom: 14px;
  }
  .lede { font-size: 1.15rem; color: var(--muted); max-width: 62ch; margin-top: 18px; }

  /* setup reminder */
  #setup {
    display: none; background: #fff3c4; color: #4a3b00; font-size: 0.9rem;
    padding: 10px 24px; text-align: center; border-bottom: 1px solid #e6d27a;
  }
  #setup code { background: rgba(0,0,0,.07); padding: 1px 5px; border-radius: 4px; }

  /* header */
  header.site {
    position: sticky; top: 0; z-index: 10;
    background: rgba(246, 241, 231, .92); backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  header.site .wrap { display: flex; align-items: center; justify-content: space-between; height: 66px; gap: 16px; }
  .brand { display: flex; align-items: baseline; gap: 10px; text-decoration: none; }
  .brand b { font-family: var(--serif); font-size: 1.45rem; font-weight: 600; }
  .brand b::after { content: "."; color: var(--accent); }
  .brand span { font-size: 0.8rem; color: var(--muted); letter-spacing: 0.04em; }
  nav { display: flex; align-items: center; gap: 26px; }
  nav a.link { text-decoration: none; font-size: 0.95rem; color: var(--muted); }
  nav a.link:hover { color: var(--ink); }

  /* buttons */
  .btn {
    display: inline-block; text-decoration: none; font-weight: 600; font-size: 1rem;
    padding: 14px 24px; border-radius: 999px; border: 2px solid transparent;
    transition: background .15s, transform .15s, border-color .15s;
  }
  .btn:active { transform: translateY(1px); }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-primary:hover { background: var(--accent-dark); }
  .btn-ghost { border-color: var(--ink); color: var(--ink); }
  .btn-ghost:hover { background: var(--ink); color: var(--paper); }
  .btn-small { padding: 9px 18px; font-size: 0.92rem; }
  .btn-light { background: var(--paper); color: var(--ink); }
  .btn-light:hover { background: #fff; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 6px; }

  /* hero */
  .hero { padding: 72px 0 84px; }
  .hero .wrap { display: grid; grid-template-columns: 1.15fr .85fr; gap: 56px; align-items: center; }
  .hero h1 em { font-style: italic; color: var(--green); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; align-items: center; }
  .cta-note { font-size: 0.9rem; color: var(--muted); margin-top: 14px; }

  .morning {
    background: var(--green); color: #eef3ee; border-radius: 20px; padding: 28px 28px 24px;
    box-shadow: 0 24px 50px -28px rgba(23, 32, 27, .55);
  }
  .morning .cap { display: flex; justify-content: space-between; font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: #a9c2b3; }
  .morning ul { list-style: none; margin: 20px 0 0; padding: 0; }
  .morning li {
    display: flex; align-items: center; gap: 14px; padding: 13px 0;
    border-top: 1px solid rgba(255,255,255,.12); font-size: 1.02rem;
    opacity: .38; animation: done .5s ease forwards;
  }
  .morning li i {
    flex: none; width: 24px; height: 24px; border-radius: 50%;
    border: 2px solid #a9c2b3; display: grid; place-items: center;
    animation: tick .5s ease forwards;
  }
  .morning li i svg { width: 12px; height: 12px; opacity: 0; animation: show .3s ease forwards; }
  .morning li:nth-child(1), .morning li:nth-child(1) i, .morning li:nth-child(1) svg { animation-delay: .6s; }
  .morning li:nth-child(2), .morning li:nth-child(2) i, .morning li:nth-child(2) svg { animation-delay: 1.3s; }
  .morning li:nth-child(3), .morning li:nth-child(3) i, .morning li:nth-child(3) svg { animation-delay: 2.0s; }
  .morning li:nth-child(4), .morning li:nth-child(4) i, .morning li:nth-child(4) svg { animation-delay: 2.7s; }
  .morning li:nth-child(5), .morning li:nth-child(5) i, .morning li:nth-child(5) svg { animation-delay: 3.4s; }
  @keyframes done { to { opacity: 1; } }
  @keyframes tick { to { background: #f3b58f; border-color: #f3b58f; } }
  @keyframes show { to { opacity: 1; } }
  .morning .foot { margin-top: 18px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,.12); font-family: var(--serif); font-size: 1.15rem; font-style: italic; color: #fff; }
  .morning .src { font-family: var(--sans); font-style: normal; font-size: 0.8rem; color: #a9c2b3; display: block; margin-top: 4px; }

  /* pain */
  .pain { background: var(--card); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 40px; }
  .pain-item { padding: 22px 0 0; border-top: 3px solid var(--ink); }
  .pain-item p { color: var(--muted); margin-top: 8px; }

  /* services */
  .services { display: grid; grid-template-columns: repeat(6, 1fr); gap: 20px; margin-top: 44px; }
  .service {
    grid-column: span 2; background: var(--card); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 26px;
  }
  .service:nth-child(4), .service:nth-child(5) { grid-column: span 3; }
  .service .num { font-family: var(--serif); color: var(--accent-dark); font-size: 0.95rem; }
  .service h3 { margin-top: 8px; }
  .service p { color: var(--muted); margin-top: 10px; font-size: 0.98rem; }

  /* proof */
  .proof { background: var(--ink); color: #f1ede3; }
  .proof .eyebrow { color: #f3b58f; }
  .proof .lede { color: #b7c0b9; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: 48px; border-top: 1px solid rgba(255,255,255,.16); border-bottom: 1px solid rgba(255,255,255,.16); }
  .stat { padding: 30px 22px 28px 0; }
  .stat + .stat { padding-left: 26px; border-left: 1px solid rgba(255,255,255,.16); }
  .stat b { display: block; font-family: var(--serif); font-size: clamp(2.2rem, 4.6vw, 3.4rem); font-weight: 600; line-height: 1; color: #fff; }
  .stat span { display: block; margin-top: 10px; font-size: 0.95rem; color: #b7c0b9; }
  .proof-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 48px; margin-top: 44px; }
  .proof-cols div { padding-left: 18px; border-left: 2px solid #f3b58f; }
  .proof-cols b { display: block; color: #fff; font-weight: 600; }
  .proof-cols span { color: #b7c0b9; font-size: 0.97rem; }
  .fine { margin-top: 36px; font-size: 0.85rem; color: #8f9a93; max-width: 70ch; }

  /* steps */
  .steps { list-style: none; margin: 44px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; counter-reset: step; }
  .steps li { counter-increment: step; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 26px 24px; position: relative; }
  .steps li::before {
    content: counter(step); font-family: var(--serif); font-weight: 600; font-size: 1.05rem;
    width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center;
    background: var(--green-soft); color: var(--green); margin-bottom: 16px;
  }
  .steps li.first { background: var(--green); border-color: var(--green); color: #eef3ee; }
  .steps li.first::before { background: #f3b58f; color: var(--ink); }
  .steps li.first p { color: #c5d6cb; }
  .steps .tag { display: inline-block; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-dark); margin-bottom: 6px; }
  .steps li.first .tag { color: #f3b58f; }
  .steps p { color: var(--muted); margin-top: 10px; font-size: 0.96rem; }

  /* faq */
  .faq { background: var(--card); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .faq .wrap { display: grid; grid-template-columns: .8fr 1.2fr; gap: 56px; }
  details { border-top: 1px solid var(--line); }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer; padding: 20px 36px 20px 0; position: relative;
    font-family: var(--serif); font-size: 1.2rem; font-weight: 600;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; position: absolute; right: 4px; top: 16px; font-family: var(--sans); font-weight: 400; font-size: 1.5rem; color: var(--accent-dark); }
  details[open] summary::after { content: "\2212"; }
  details p { color: var(--muted); padding: 0 36px 22px 0; }

  /* final cta */
  .final { padding: 0 0 84px; margin-top: 84px; }
  .final .box { background: var(--accent); color: #fff; border-radius: 24px; padding: 64px 48px; text-align: center; }
  .final h2 { max-width: 20ch; margin: 0 auto; }
  .final p { max-width: 56ch; margin: 18px auto 30px; color: #ffe6d8; font-size: 1.1rem; }

  footer { border-top: 1px solid var(--line); padding: 30px 0 44px; font-size: 0.9rem; color: var(--muted); }
  footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 24px; }
  footer a { text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 900px) {
    section { padding: 60px 0; }
    .hero { padding: 44px 0 60px; }
    .hero .wrap, .faq .wrap { grid-template-columns: 1fr; gap: 36px; }
    .grid-3 { grid-template-columns: 1fr; }
    .services { grid-template-columns: 1fr; }
    .service, .service:nth-child(4), .service:nth-child(5) { grid-column: auto; }
    .stats { grid-template-columns: 1fr 1fr; }
    .stat { padding: 24px 16px 22px 0; }
    .stat + .stat { padding-left: 20px; }
    .stat:nth-child(3) { border-left: 0; padding-left: 0; }
    .stat:nth-child(n+3) { border-top: 1px solid rgba(255,255,255,.16); }
    .proof-cols { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr 1fr; }
    .final { margin-top: 60px; padding-bottom: 60px; }
    .final .box { padding: 44px 24px; }
    nav a.link { display: none; }
  }
  @media (max-width: 560px) {
    body { font-size: 16px; }
    .wrap { padding: 0 18px; }
    .steps { grid-template-columns: 1fr; }
    .brand span { display: none; }
    .cta-row .btn { width: 100%; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .morning li, .morning li i, .morning li i svg { animation-duration: .01s; animation-delay: 0s !important; }
  }
</style>
</head>
<body>

<div id="setup" role="note"></div>

<header class="site">
  <div class="wrap">
    <a class="brand" href="#top"><b data-site="brand">Julienne</b><span data-site="tagline">Office automation</span></a>
    <nav>
      <a class="link" href="#what">What I automate</a>
      <a class="link" href="#proof">Proof</a>
      <a class="link" href="#how">How it works</a>
      <a class="btn btn-primary btn-small" data-cta href="#book">Book a free audit</a>
    </nav>
  </div>
</header>

<main id="top">

  <section class="hero">
    <div class="wrap">
      <div>
        <p class="eyebrow">Done-for-you office automation</p>
        <h1>Your team's busywork, done <em>before anyone logs on.</em></h1>
        <p class="lede">I build automations that take repetitive office work off your team's plate: chasing leads, updating the CRM, sorting the inbox, putting reports together. You get hours back every week, without hiring.</p>
        <div class="cta-row">
          <a class="btn btn-primary" data-cta href="#book">Book a free 15-minute audit</a>
          <a class="btn btn-ghost" href="#proof">See it working</a>
        </div>
        <p class="cta-note">I'll point out 2–3 things your team still does by hand that are easy to automate. No pitch, no obligation.</p>
      </div>

      <aside class="morning" aria-label="What runs automatically each weekday morning in a live client system">
        <div class="cap"><span>Weekday morning</span><span>Runs itself</span></div>
        <ul>
          <li><i><svg viewBox="0 0 12 12" fill="none" stroke="#17201b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6.5l2.6 2.6L10 3.4"/></svg></i>New leads found and researched</li>
          <li><i><svg viewBox="0 0 12 12" fill="none" stroke="#17201b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6.5l2.6 2.6L10 3.4"/></svg></i>Follow-up emails sent</li>
          <li><i><svg viewBox="0 0 12 12" fill="none" stroke="#17201b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6.5l2.6 2.6L10 3.4"/></svg></i>CRM updated, notes logged</li>
          <li><i><svg viewBox="0 0 12 12" fill="none" stroke="#17201b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6.5l2.6 2.6L10 3.4"/></svg></i>Bounced contacts cleaned up</li>
          <li><i><svg viewBox="0 0 12 12" fill="none" stroke="#17201b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6.5l2.6 2.6L10 3.4"/></svg></i>Sales summary in the team's inbox</li>
        </ul>
        <p class="foot">All before anyone logs on.<span class="src">From a system I run for a client today</span></p>
      </aside>
    </div>
  </section>

  <section class="pain">
    <div class="wrap">
      <p class="eyebrow">Sound familiar?</p>
      <h2>Most teams lose hours a week to work nobody was hired to do.</h2>
      <div class="grid-3">
        <div class="pain-item">
          <h3>Leads go cold</h3>
          <p>Follow-ups depend on someone remembering. When the week gets busy, they don't happen.</p>
        </div>
        <div class="pain-item">
          <h3>Reports are built by hand</h3>
          <p>The same numbers get pulled, pasted and formatted every day or every week.</p>
        </div>
        <div class="pain-item">
          <h3>Data is copy-pasted between tools</h3>
          <p>Your CRM, inbox and spreadsheets don't talk to each other, so a person does it for them.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="what">
    <div class="wrap">
      <p class="eyebrow">What I automate</p>
      <h2>Five builds, each one already running in production.</h2>
      <p class="lede">I automate between the tools you already use, so there's nothing new for your team to learn.</p>
      <div class="services">
        <article class="service">
          <span class="num">01</span>
          <h3>Outreach machine</h3>
          <p>Finds leads, verifies their emails, sends a staged follow-up sequence, and routes replies and bounces back into your CRM.</p>
        </article>
        <article class="service">
          <span class="num">02</span>
          <h3>CRM sync and live dashboard</h3>
          <p>Contacts, deals and accounts stay clean and in sync with no manual exports, with a live view of sales and operations.</p>
        </article>
        <article class="service">
          <span class="num">03</span>
          <h3>Inbox triage and AI drafting</h3>
          <p>Incoming email is labelled automatically and replies are drafted in your voice, ready for you to check and send.</p>
        </article>
        <article class="service">
          <span class="num">04</span>
          <h3>Reporting that builds itself</h3>
          <p>Daily and weekly reports compile and send themselves, so nobody spends Friday afternoon assembling numbers.</p>
        </article>
        <article class="service">
          <span class="num">05</span>
          <h3>Data entry and sync jobs</h3>
          <p>Information moves between your tools on a schedule. No copy-paste, no missed rows, safe to re-run.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="proof" id="proof">
    <div class="wrap">
      <p class="eyebrow">Case study</p>
      <h2>How a travel &amp; adventure company got about 40 hours a week back.</h2>
      <p class="lede">Their sales and back office ran largely by hand: prospecting, follow-ups, CRM updates and reporting all ate into the week. Over six months I built one connected system that now runs every weekday without anyone touching it.</p>

      <div class="stats">
        <div class="stat"><b>~40</b><span>hours a week saved across the team (estimated)</span></div>
        <div class="stat"><b>30+</b><span>automated workflows live in production</span></div>
        <div class="stat"><b>12</b><span>live dashboards on real-time data</span></div>
        <div class="stat"><b>10</b><span>AI routines for drafting, analysis and triage</span></div>
      </div>

      <div class="proof-cols">
        <div><b>Lead generation on autopilot</b><span>The pipeline fills every morning with no manual research, saving about 5 hours a week on prospecting alone.</span></div>
        <div><b>Follow-ups that never forget</b><span>Staged email sequences nurture every lead, so nothing slips when the team is busy.</span></div>
        <div><b>A CRM that updates itself</b><span>Records stay synced and a note is logged at every follow-up stage.</span></div>
        <div><b>Replies and bounces handled</b><span>Replies go straight to the sales team; dead addresses are closed out automatically.</span></div>
        <div><b>Zero-effort reporting</b><span>A daily sales summary and weekly reports compile and send themselves.</span></div>
        <div><b>Cheap to run</b><span>Around 30 scheduled jobs fire in order each morning for close to zero monthly running cost.</span></div>
      </div>

      <p class="fine">Client name withheld for confidentiality. Hours saved are the client-side estimates from a six-month performance review.</p>
    </div>
  </section>

  <section id="how">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2>Start with fifteen minutes. Go further only if it's worth it.</h2>
      <ol class="steps">
        <li class="first">
          <span class="tag">Free</span>
          <h3>Time-waster audit</h3>
          <p>A 15-minute call. You tell me how the week goes; I name the 2–3 manual jobs that are easiest to automate.</p>
        </li>
        <li>
          <span class="tag">About 1 week</span>
          <h3>Automation roadmap</h3>
          <p>A fixed-price deep dive: your top 5–8 automatable processes, hours saved for each, and the order to build them in.</p>
        </li>
        <li>
          <span class="tag">1–3 weeks each</span>
          <h3>Done-for-you build</h3>
          <p>I build, test and hand over each automation for a fixed price agreed up front. No hourly billing.</p>
        </li>
        <li>
          <span class="tag">Monthly</span>
          <h3>Automation partner</h3>
          <p>I keep everything running, fix what breaks, and ship one or two new small automations every month.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="faq">
    <div class="wrap">
      <div>
        <p class="eyebrow">Questions</p>
        <h2>The things people ask first.</h2>
      </div>
      <div>
        <details open>
          <summary>We're a small team. Is this for us?</summary>
          <p>Small teams benefit most, because you don't have staff to spare on manual work. The first call is free, and you'll leave with a few usable ideas either way.</p>
        </details>
        <details>
          <summary>We already use a CRM and other tools.</summary>
          <p>Good. I don't replace them. I automate between them, so your CRM, inbox, spreadsheets and reports talk to each other without a person in the middle.</p>
        </details>
        <details>
          <summary>Is this AI that replaces my team?</summary>
          <p>No. It removes the boring, repetitive parts of the job so your team can spend their time on the work only people can do.</p>
        </details>
        <details>
          <summary>How do I know it will actually work?</summary>
          <p>The system in the case study above has run every weekday in production for months: 30+ automations saving that team an estimated 40 hours a week. I build yours the same way.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="final" id="book">
    <div class="wrap">
      <div class="box">
        <h2>Find out what your team could stop doing by hand.</h2>
        <p>Book a free 15-minute time-waster audit. I'll point out the 2–3 easiest wins for your business. No pitch, no obligation.</p>
        <a class="btn btn-light" data-cta data-final href="#book">Book your free audit</a>
      </div>
    </div>
  </section>

</main>

<footer>
  <div class="wrap">
    <span>&copy; <span id="year">2026</span> <span data-site="brand">Julienne</span><span id="loc"></span><span id="abn"></span></span>
    <span id="contact"></span>
  </div>
</footer>

<script>
  (function () {
    var s = window.SITE || {};
    var has = function (v) { return typeof v === "string" && v.trim() !== ""; };

    document.querySelectorAll("[data-site]").forEach(function (el) {
      var v = s[el.getAttribute("data-site")];
      if (has(v)) el.textContent = v;
    });
    if (has(s.brand)) document.title = document.title.replace("Julienne", s.brand);
    document.getElementById("year").textContent = new Date().getFullYear();
    if (has(s.location)) document.getElementById("loc").textContent = " · " + s.location;
    if (has(s.abn)) document.getElementById("abn").textContent = " · ABN " + s.abn;

    var mailto = has(s.email)
      ? "mailto:" + s.email + "?subject=" + encodeURIComponent("Free 15-minute time-waster audit")
      : "";
    if (has(s.email)) {
      var a = document.createElement("a");
      a.href = "mailto:" + s.email;
      a.textContent = s.email;
      document.getElementById("contact").appendChild(a);
    }

    // CTAs: booking link if set, otherwise email, otherwise scroll to the final section.
    var target = has(s.bookingUrl) ? s.bookingUrl : mailto;
    document.querySelectorAll("[data-cta]").forEach(function (el) {
      if (target) {
        el.href = target;
        if (has(s.bookingUrl)) { el.target = "_blank"; el.rel = "noopener"; }
      } else if (el.hasAttribute("data-final")) {
        el.textContent = "Booking link coming soon";
        el.removeAttribute("href");
        el.setAttribute("aria-disabled", "true");
        el.style.opacity = ".75";
      }
    });

    var missing = [];
    if (!has(s.bookingUrl)) missing.push("bookingUrl");
    if (!has(s.email)) missing.push("email");
    if (!has(s.location)) missing.push("location");
    if (missing.length) {
      var bar = document.getElementById("setup");
      bar.innerHTML = "Not ready to publish. Still to set in <code>window.SITE</code> at the top of index.html: " +
        missing.map(function (m) { return "<code>" + m + "</code>"; }).join(", ");
      bar.style.display = "block";
    }
  })();
</script>
</body>
</html>
